# Database
DB_HOST=localhost
DB_PORT=5434
DB_NAME=ecommerce_fraud
DB_USER=postgres
DB_PASSWORD=changeme

POSTGRES_DB=ecommerce_fraud
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# development | staging | production
# production/staging: refuse weak secrets, Secure cookies, Groq TLS verify, strict schema.
APP_ENV=development
# COOKIE_SECURE=true
# SCHEMA_STRICT=true

GROQ_API_KEY=your_groq_api_key_here
# TLS for Groq. Defaults: false in development, true in production/staging.
GROQ_SSL_VERIFY=false
# Optional model overrides (defaults use faster openai/gpt-oss-20b).
# GROQ_INTENT_MODEL=openai/gpt-oss-20b
# GROQ_SQL_MODEL=openai/gpt-oss-20b
# GROQ_REPAIR_MODEL=openai/gpt-oss-20b
# GROQ_SUMMARY_MODEL=openai/gpt-oss-20b
API_BASE_URL=http://127.0.0.1:8000
CORS_ALLOW_ORIGINS=http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
POWER_BI_EMBED_URL=
# Use a long random value (>= 32 chars). Demo default is refused when APP_ENV=production.
PORTAL_SECRET=replace_with_a_long_random_secret
# Login brute-force protection (in-process)
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900
SYSTEM_AUDIT_LOG_PATH=
# Optional JSONL file backup of audit events (DB is source of truth). Default true.
SYSTEM_AUDIT_FILE_BACKUP=true

# Keycloak SSO (analyst portal). Local username/password login still works.
KEYCLOAK_ENABLED=true
KEYCLOAK_URL=http://127.0.0.1:8080
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=metro-cart
KEYCLOAK_CLIENT_ID=analyst-portal
KEYCLOAK_CLIENT_SECRET=replace_with_a_client_secret
KEYCLOAK_REDIRECT_URI=http://127.0.0.1:8000/auth/sso/callback
SSO_DEFAULT_RETURN_TO=http://127.0.0.1:8000/portal/
KEYCLOAK_ADMIN=replace_with_admin_username
KEYCLOAK_ADMIN_PASSWORD=replace_with_admin_password
# Local demo: start-dev. Production: start (also set KC_HOSTNAME / proxy vars below).
KEYCLOAK_START_MODE=start-dev
# KC_HOSTNAME=auth.example.com
# KC_HOSTNAME_STRICT=true
# KC_PROXY_HEADERS=xforwarded
# KC_HTTP_ENABLED=true
