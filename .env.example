# Database
DB_HOST=localhost
DB_PORT=5434
DB_NAME=ecommerce_fraud
DB_USER=postgres
DB_PASSWORD=changeme

POSTGRES_DB=ecommerce_fraud
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

GROQ_API_KEY=your_groq_api_key_here
API_BASE_URL=http://127.0.0.1:8000
CORS_ALLOW_ORIGINS=http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
POWER_BI_EMBED_URL=
PORTAL_SECRET=replace_with_a_long_random_secret
SYSTEM_AUDIT_LOG_PATH=

# Keycloak SSO (analyst portal). Local username/password login still works.
KEYCLOAK_ENABLED=true
KEYCLOAK_URL=http://127.0.0.1:8080
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=metro-cart
KEYCLOAK_CLIENT_ID=analyst-portal
KEYCLOAK_CLIENT_SECRET=replace_with_a_client_secret
KEYCLOAK_REDIRECT_URI=http://127.0.0.1:8000/auth/sso/callback
SSO_DEFAULT_RETURN_TO=http://127.0.0.1:8000/portal/
KEYCLOAK_ADMIN=replace_with_admin_username
KEYCLOAK_ADMIN_PASSWORD=replace_with_admin_password
KEYCLOAK_START_MODE=start-dev
